          "type": "html",
          "html": "<svg width=\"400\" height=\"90\" viewBox=\"0 0 500 150\"><title>Accessible equation</title><text x=\"20\" y=\"50\" font-size=\"25\">Đồ thị an toàn</text></svg><math><mfrac><mi>x</mi><mn>2</mn></mfrac></math>",
          "height": 200
        }
      ]
    },
    {
      "type": "composer",
      "id": "pipeline",
      "title": "Relational data pipeline",
      "components": [
        {
          "type": "table",
          "dataRef": "base",
          "transform": {
            "join": {
              "leftKey": "key",
              "rightDataset": "targets",
              "rightKey": "id"
            },
            "derive": {
              "delta": {
                "op": "subtract",
                "args": [
                  {
                    "field": "after"
                  },
                  {
                    "field": "before"
                  }
                ]
              },
              "ratio": {
                "op": "percent",
                "args": [
                  {
                    "field": "after"
                  },
                  {
                    "field": "target"
                  }
                ]
              }
            },
            "select": [
              "label",
              "delta",
              "ratio"
            ]
          }
        }
      ]
    }
